# cash: paiement à la remise en main propre (mode actuel)
# online: réactive les endpoints de paiement en ligne existants
PAYMENTS_MODE=cash

# Vide par défaut : aucune image n'est envoyée à un service IA sans fournisseur configuré.
# Une implémentation future peut être activée avec son chemin Python complet.
SELLER_ASSISTANT_PROVIDER=

# Négociation: nombre maximal de propositions, durée de validité et réservation temporaire.
NEGOTIATION_MAX_PROPOSALS=5
NEGOTIATION_OFFER_TTL_HOURS=48
NEGOTIATION_RESERVATION_MINUTES=30

# Vide par défaut : aucune photo ne sera transmise à un moteur de recherche visuelle.
# Une intégration future peut être activée avec le chemin Python complet du provider.
VISUAL_SEARCH_PROVIDER=

# Vide par défaut : aucune IA commerciale n'est appelée avant activation explicite.
BUYER_ASSISTANT_PROVIDER=